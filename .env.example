# Copy to .env before docker compose up --build
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://drawspace:replace-with-a-long-random-password@localhost:5432/drawspace
APP_URL=http://localhost:3000
# Set true when APP_URL uses HTTPS (required for an internet-facing deployment).
COOKIE_SECURE=false
# Set false to disable new registrations after creating your team accounts.
ALLOW_REGISTRATION=true
# Optional Discord login. Set both values from your Discord developer application.
# Register APP_URL/api/auth/discord/callback as its OAuth2 redirect URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PORT=3000
